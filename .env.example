# Amazigh Learning App — environment configuration
# Copy to .env.development / .env.staging / .env.production (or .env for local overrides).
# Select the file at build time with ENVFILE=.env.staging (see README → "Environments").
#
# ⚠️ NEVER put secrets here (no service-account keys, no API secrets). Firebase
# config files (google-services.json, GoogleService-Info.plist) stay out of git —
# see docs/FIREBASE_SECURITY.md.

APP_ENV=development

# Firebase project per environment (non-secret identifiers; filled in after issue #44)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
