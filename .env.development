EXPO_PUBLIC_APP_ENV=development

# Firebase project: amazigh-learning-dev (values filled in after issue #44)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local Firebase emulators (development only, host:port).
# Leave empty: the app auto-detects the address per platform
# (Android emulator -> 10.0.2.2, iOS simulator -> localhost).
# Set these only to override, e.g. for a physical device use your machine's LAN IP.
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=
EXPO_PUBLIC_AUTH_EMULATOR_HOST=

# Set to "false" to bypass the emulators in development builds.
EXPO_PUBLIC_USE_EMULATORS=true
