{
  "name": "amazigh-learning-app",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "android:dev": "EXPO_PUBLIC_APP_ENV=development expo run:android",
    "android:staging": "EXPO_PUBLIC_APP_ENV=staging expo run:android",
    "android:prod": "EXPO_PUBLIC_APP_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "EXPO_PUBLIC_APP_ENV=development expo run:ios",
    "ios:staging": "EXPO_PUBLIC_APP_ENV=staging expo run:ios",
    "ios:prod": "EXPO_PUBLIC_APP_ENV=production expo run:ios",
    "lint": "eslint .",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-amazigh-learning 'jest --config jest.emulator.config.js --runInBand --forceExit'",
    "seed:emulator": "firebase emulators:exec --only firestore,auth --project demo-amazigh-learning 'node scripts/seed-emulator.mjs'",
    "typecheck": "tsc --noEmit",
    "typecheck:emulator": "tsc --noEmit -p tsconfig.emulator.json",
    "validate:vocabulary": "node scripts/validate-vocabulary.mjs",
    "test:scripts": "node --test scripts/lib/vocabulary.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^11.10.0",
    "i18next": "^27.1.3",
    "react": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.25",
    "eslint": "^8.19.0",
    "firebase-tools": "^13.35.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.13.0"
  }
}
